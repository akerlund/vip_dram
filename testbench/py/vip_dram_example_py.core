CAPI=2:
name: "akerlund::vip_dram_example_py:0"
description: "VIP DRAM example - pyUVM/cocotb flow (Verilator)"

# FuseSoC core for the Python (pyUVM/cocotb) port, using Edalize's *flow* API
# (not the deprecated tool API). The 'sim' flow's cocotb_module option wires
# cocotb in directly: Verilator is built with cocotb's VPI + verilator.cpp and
# the model is launched with COCOTB_TEST_MODULES set, so `fusesoc run --target
# sim` builds AND runs the cocotb testbench in one step.
#
# The top is the pure-TLM shell (dram_hdl_top): the vip_dram device has NO
# signals -- every delay is a cocotb Timer against absolute ns -- so unlike the
# AXI4 example there are no top-level nets to expose (no --public-flat-rw needed).
#
# IMPORTANT -- PYTHONPATH: FuseSoC runs cocotb from its build work_root, so the
# directory holding dram_tb_top.py (tb/) must be on PYTHONPATH for cocotb to
# import the test module. dram_tb_top.py then bootstraps the rest of
# the source dirs (vip_dram py/, submodules/vip_memory/py, tb/, tc/) onto
# sys.path itself. Use run_fusesoc.sh, which exports PATH + PYTHONPATH.
#
# All 15 test cases run sequentially in ONE simulator process. pyUVM's
# run_test() clears the factory overrides + singletons between tests and cocotb
# kills each test's background tasks at test end, so per-test isolation holds
# without fresh sims. Select a subset with COCOTB_TEST_FILTER (a regex matched
# against the public @cocotb.test names, e.g. "tc_dram_smoke" or
# "tc_dram_smoke|tc_dram_read_fault").

filesets:
  tb:
    files:
      - tb/dram_hdl_top.sv
    file_type: systemVerilogSource

targets:
  default: &default
    flow: sim
    flow_options:
      tool: verilator
    filesets:
      - tb
    toplevel: dram_hdl_top

  # `fusesoc run --target lint ...` -- structural + lint check via Verilator.
  lint:
    <<: *default
    flow: lint
    flow_options:
      tool: verilator
      verilator_options:
        - -Wno-fatal

  # `fusesoc run --target sim ...` (via run_fusesoc.sh) -- build the Verilated
  # model with cocotb's VPI and launch the cocotb testbench (all TCs).
  sim:
    <<: *default
    flow_options:
      tool: verilator
      cocotb_module: dram_tb_top
      mode: cc
      verilator_options:
        - -Wno-fatal
